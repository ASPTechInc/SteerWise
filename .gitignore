# Project-wide ignore rules for SteerWise.
# Platform-specific rules live in android/, ios/, linux/, macos/ and
# windows/.gitignore (generated by Flutter).
#
# pubspec.lock is committed on purpose so that CI, F-Droid and other
# developers resolve the same package versions.

# Flutter/Dart/Pub
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/
.swiftpm/
migrate_working_dir/

# Symbolication and obfuscation output (flutter build --split-debug-info / --obfuscate)
app.*.symbols
app.*.map.json

# Android Studio build artefacts and signing secrets
/android/app/debug
/android/app/profile
/android/app/release
keystore.properties
*.jks
*.keystore
*.hprof

# Release packages
*.apk
*.aab
*.ipa

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code (the shared launch configurations are committed)
.vscode/*
!.vscode/launch.json

# Python virtual environment used for pre-commit and git-filter-repo
.venv/
__pycache__/
*.pyc

# Logs written by scripts/log-errors.sh
logs/
*.log

# act (local GitHub Actions runner) inputs and artefacts
.env
.env.*
.vars
.secrets
.artifacts/

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
